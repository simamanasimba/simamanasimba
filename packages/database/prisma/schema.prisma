// ─────────────────────────────────────────────────────────────────────────
// MEDIA CAMPAIGNS, INFLUENCERS, TRACKER ENGINE, FINANCE
// A reusable session/metric/entry shape (TrackerMetric → TrackerSession →
// TrackerEntry) so future trackers beyond media/influencer don't need new
// tables — only new metric definitions and a subject type.
// ─────────────────────────────────────────────────────────────────────────

enum MediaHostType {
  TV
  RADIO
  NEWSPAPER
  WEBSITE
  BLOG
  SOCIAL_MEDIA
  // Added for the Media House -> Channel -> Program hierarchy's seed catalog — never remove
  // the values above, existing MediaHost rows may already use them.
  ONLINE_TV
  NEWS_WEBSITE
  MAGAZINE
  FORUM
  PODCAST
  DIGITAL_PUBLISHER
  OTHER
}

model MediaHost {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  name           String
  type           MediaHostType @default(OTHER)
  // Which Media House (e.g. "Azam Media") this host belongs to — optional, since not every
  // host needs to be tied to the reference catalog. Powers "list of hosts belonging to a
  // certain media" on the Media Hosts page.
  mediaOutletId  String?       @map("media_outlet_id")
  // Channel (e.g. "Azam One") and Kipindi/session (e.g. "Mashamsham") this host is known for —
  // plain text, picked via cascading dropdowns sourced from the reference catalog (Media ->
  // Channel -> Kipindi) rather than a separate table, so there's nothing new to keep in sync.
  channelName    String?       @map("channel_name")
  programName    String?       @map("program_name")
  contactName    String?       @map("contact_name")
  contactPhone   String?       @map("contact_phone")
  contactEmail   String?       @map("contact_email")
  notes          String?       @db.Text

  // Default payout details — prefilled into the payment form when this host is selected.
  bankName           String? @map("bank_name")
  bankAccountName    String? @map("bank_account_name")
  bankAccountNumber  String? @map("bank_account_number")
  mobileMoneyProvider String? @map("mobile_money_provider")
  mobileMoneyNumber   String? @map("mobile_money_number")

  // Whether this host is currently working with the club — toggled manually (no lifecycle
  // rule derives it), shown to Finance so they know who's a current vs. past partner.
  isActive Boolean @default(true) @map("is_active")

  // Goal total reach (likes+comments across all engagements) for this host's "Total reach" gauge.
  reachTarget Int? @map("reach_target")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignLinks  CampaignMediaHost[]
  trackerEntries TrackerEntry[]
  payments       Payment[]
  engagements    MediaEngagement[]
  mediaOutlet    MediaOutlet?        @relation(fields: [mediaOutletId], references: [id])
  postingAgreements PostingAgreement[]

  @@index([organizationId])
  @@map("media_hosts")
}

// Media House reference catalog (e.g. "Azam Media") — Channel and Kipindi/session are plain
// text fields directly on MediaHost (see above), sourced live from the JSON reference catalog
// for the cascading dropdown, so there's no separate Channel/Program table to keep in sync.
model MediaOutlet {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  // The catalog JSON's own stable id (e.g. "mh_003") for rows created by the seed importer —
  // null for outlets an admin creates by hand. Matching on this (not `name`) is what lets an
  // admin rename a seeded outlet without the next boot's reseed treating the rename as a
  // different entity and recreating a duplicate under the original name.
  externalId     String?  @map("external_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hosts        MediaHost[]

  @@unique([organizationId, name])
  @@unique([organizationId, externalId])
  @@map("media_outlets")
}

enum InfluencerType {
  CELEBRITY
  ATHLETE
  MUSICIAN
  CONTENT_CREATOR
  BLOGGER
  MEDIA_PERSONALITY
  MICRO_INFLUENCER
  OTHER
}

model Influencer {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  name           String
  type           InfluencerType @default(OTHER)
  brandName      String?  @map("brand_name")
  phone          String?
  // Extra numbers this influencer wants to share, beyond the primary `phone` above — plain
  // string array (e.g. ["+255...", "+255..."]), never used as a payment default, just contact info.
  additionalPhones Json?  @map("additional_phones")
  email          String?
  socialHandle   String?  @map("social_handle")
  notes          String?  @db.Text
  contractStartDate DateTime? @map("contract_start_date") @db.Date
  agreementUrl      String?   @map("agreement_url")

  // Default payout details — prefilled into the payment form when this influencer is selected.
  bankName           String? @map("bank_name")
  bankAccountName    String? @map("bank_account_name")
  bankAccountNumber  String? @map("bank_account_number")
  mobileMoneyProvider String? @map("mobile_money_provider")
  mobileMoneyNumber   String? @map("mobile_money_number")

  // Whether this influencer is currently working with the club — toggled manually (no
  // lifecycle rule derives it), shown to Finance so they know who's a current vs. past partner.
  isActive Boolean @default(true) @map("is_active")

  // Goal total reach (likes+comments across all engagements) for this influencer's "Total reach" gauge.
  reachTarget Int? @map("reach_target")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignLinks  CampaignInfluencer[]
  trackerEntries TrackerEntry[]
  payments       Payment[]
  engagements    MediaEngagement[]
  postingAgreements PostingAgreement[]

  @@index([organizationId])
  @@map("influencers")
}

enum MediaEngagementStatus {
  NOT_PAID
  PAID
}

/// One "campaign" booked for a specific media host or influencer — what the user
/// calls "create campaign": a single engagement cycle with its own rate, narrative,
/// and pay status. A host/influencer has many of these over time. Finance pays
/// against one of these (its status flips NOT_PAID -> PAID once a Payment is recorded).
model MediaEngagement {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  mediaHostId    String?                @map("media_host_id")
  influencerId   String?                @map("influencer_id")
  status         MediaEngagementStatus  @default(NOT_PAID)

  // Filled in later, at payment time — not known when the campaign is first created.
  rateTzs         Decimal? @map("rate_tzs") @db.Decimal(14, 2)
  engagement      Decimal? @db.Decimal(14, 2)
  totalTzs        Decimal? @map("total_tzs") @db.Decimal(14, 2)
  engagementDates String?  @map("engagement_dates")

  link              String?   @db.Text
  reportingTimeline   String?   @map("reporting_timeline")
  natureOfNarrative   String?   @map("nature_of_narrative")
  topicPostAgenda     String?   @map("topic_post_agenda") @db.Text
  narrativeKeyMessage String?   @map("narrative_key_message") @db.Text
  reachAudience       String?   @map("reach_audience")
  memberEngagement    String?   @map("member_engagement")
  mediaImpactOutcome  String?   @map("media_impact_outcome") @db.Text
  regionalFeedback    String?   @map("regional_feedback") @db.Text
  meNotes             String?   @map("me_notes") @db.Text

  // Recorded per campaign once it's live — likes+comments together are this campaign's "reach".
  likes    Int?
  comments Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaHost    MediaHost?    @relation(fields: [mediaHostId], references: [id], onDelete: Cascade)
  influencer   Influencer?   @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  payment      Payment?
  reachLogs    MediaEngagementReachLog[]

  @@index([organizationId])
  @@index([mediaHostId, status])
  @@index([influencerId, status])
  @@map("media_engagements")
}

// A timestamped snapshot of likes+comments every time they're updated, so we can answer "what was
// this campaign's reach after 1 week / 1 month / 3 months / 1 year" without needing that info at
// the exact moment — it's reconstructed from whichever snapshot was current at each milestone date.
model MediaEngagementReachLog {
  id                String   @id @default(uuid())
  mediaEngagementId String   @map("media_engagement_id")
  likes             Int      @default(0)
  comments          Int      @default(0)
  recordedAt        DateTime @default(now()) @map("recorded_at")

  mediaEngagement MediaEngagement @relation(fields: [mediaEngagementId], references: [id], onDelete: Cascade)

  @@index([mediaEngagementId, recordedAt])
  @@map("media_engagement_reach_logs")
}

enum MediaCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model MediaCampaign {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  name           String
  description    String?             @db.Text
  campaignType   String?             @map("campaign_type")
  objective      String?             @db.Text
  startDate      DateTime?           @map("start_date") @db.Date
  endDate        DateTime?           @map("end_date") @db.Date
  status         MediaCampaignStatus @default(DRAFT)
  budget         Decimal?            @db.Decimal(14, 2)
  ownerUserId    String?             @map("owner_user_id")
  notes          String?             @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?                @relation(fields: [ownerUserId], references: [id])
  mediaHosts       CampaignMediaHost[]
  influencers      CampaignInfluencer[]
  metrics          TrackerMetric[]
  sessions         TrackerSession[]
  payments         Payment[]
  mediaActivations MediaActivation[]
  trackerReports   TrackerReport[]

  @@index([organizationId, status])
  @@map("media_campaigns")
}

/// A media plan line item — "register media for campaign" — one booked activation slot
/// (who ran what, where, when, and for how much). Distinct from CampaignMediaHost/
/// CampaignInfluencer, which just link a directory entry to a campaign.
model MediaActivation {
  id                String   @id @default(uuid())
  campaignId        String   @map("campaign_id")
  week              String?
  platformProgram   String?  @map("platform_program")
  activationChannel String?  @map("activation_channel")
  personnelOutlet   String?  @map("personnel_outlet")
  personnelRole     String?  @map("personnel_role")
  rateTzs           Decimal? @map("rate_tzs") @db.Decimal(14, 2)
  engagement        Decimal? @db.Decimal(14, 2)
  totalTzs          Decimal? @map("total_tzs") @db.Decimal(14, 2)
  engagementDates   String?  @map("engagement_dates")
  link              String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  campaign MediaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("media_activations")
}

/// A narrative/PR reporting entry — "tracker" — the qualitative counterpart to
/// TrackerMetric's numeric scoring system.
model TrackerReport {
  id                  String    @id @default(uuid())
  campaignId          String    @map("campaign_id")
  reportingTimeline   String?   @map("reporting_timeline")
  paymentDate         DateTime? @map("payment_date") @db.Date
  natureOfNarrative   String?   @map("nature_of_narrative")
  topicPostAgenda     String?   @map("topic_post_agenda") @db.Text
  narrativeKeyMessage String?   @map("narrative_key_message") @db.Text
  reachAudience       String?   @map("reach_audience")
  memberEngagement    String?   @map("member_engagement")
  mediaImpactOutcome  String?   @map("media_impact_outcome") @db.Text
  regionalFeedback    String?   @map("regional_feedback") @db.Text
  meNotes             String?   @map("me_notes") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  campaign MediaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("tracker_reports")
}

model CampaignMediaHost {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  mediaHostId String   @map("media_host_id")
  createdAt   DateTime @default(now()) @map("created_at")

  campaign  MediaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mediaHost MediaHost     @relation(fields: [mediaHostId], references: [id], onDelete: Cascade)

  @@unique([campaignId, mediaHostId])
  @@map("campaign_media_hosts")
}

model CampaignInfluencer {
  id           String   @id @default(uuid())
  campaignId   String   @map("campaign_id")
  influencerId String   @map("influencer_id")
  createdAt    DateTime @default(now()) @map("created_at")

  campaign   MediaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer Influencer    @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, influencerId])
  @@map("campaign_influencers")
}

enum MetricFieldType {
  NUMBER
  DECIMAL
  PERCENTAGE
  CURRENCY
  TEXT
  BOOLEAN
  RATING
  DATE
}

model TrackerMetric {
  id                String          @id @default(uuid())
  campaignId        String          @map("campaign_id")
  name              String
  description       String?         @db.Text
  fieldType         MetricFieldType @default(NUMBER) @map("field_type")
  unit              String?
  required          Boolean         @default(false)
  scoringEnabled    Boolean         @default(false) @map("scoring_enabled")
  weight            Decimal?        @db.Decimal(5, 2)
  minValue          Decimal?        @map("min_value") @db.Decimal(18, 2)
  maxValue          Decimal?        @map("max_value") @db.Decimal(18, 2)
  target            Decimal?        @db.Decimal(18, 2)
  calculationMethod String?         @map("calculation_method") @db.Text
  displayOrder      Int             @default(0) @map("display_order")
  createdAt         DateTime        @default(now()) @map("created_at")

  campaign MediaCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entries  TrackerEntry[]

  @@index([campaignId])
  @@map("tracker_metrics")
}

enum TrackerSessionStatus {
  DRAFT
  COMPLETED
  LOCKED
}

model TrackerSession {
  id              String               @id @default(uuid())
  campaignId      String               @map("campaign_id")
  sessionDate     DateTime             @map("session_date") @db.Date
  status          TrackerSessionStatus @default(DRAFT)
  createdByUserId String               @map("created_by_user_id")
  updatedByUserId String?              @map("updated_by_user_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  campaign MediaCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entries  TrackerEntry[]

  @@unique([campaignId, sessionDate])
  @@index([campaignId])
  @@map("tracker_sessions")
}

enum TrackerSubjectType {
  MEDIA_HOST
  INFLUENCER
}

model TrackerEntry {
  id           String             @id @default(uuid())
  sessionId    String             @map("session_id")
  metricId     String             @map("metric_id")
  subjectType  TrackerSubjectType @map("subject_type")
  // Denormalized copy of whichever of mediaHostId/influencerId applies, used
  // only for the uniqueness key below — kept separate from the real nullable
  // FK columns because MySQL treats every NULL as distinct in a unique
  // index (so two NULLs never collide the way we need), while an empty-
  // string sentinel directly on a FK column would violate the constraint
  // instead. This plain string carries no FK, so neither problem applies.
  subjectId    String             @map("subject_id")
  mediaHostId  String?            @map("media_host_id")
  influencerId String?            @map("influencer_id")
  numericValue Decimal?           @map("numeric_value") @db.Decimal(18, 2)
  textValue    String?            @map("text_value")
  boolValue    Boolean?           @map("bool_value")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  session    TrackerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  metric     TrackerMetric  @relation(fields: [metricId], references: [id], onDelete: Cascade)
  mediaHost  MediaHost?     @relation(fields: [mediaHostId], references: [id], onDelete: Cascade)
  influencer Influencer?    @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, metricId, subjectId])
  @@index([sessionId])
  @@index([metricId])
  @@map("tracker_entries")
}

enum PaymentBeneficiaryType {
  MEDIA_HOST
  INFLUENCER
  /// A member (typically a leader) paid directly — e.g. for attending/organizing a meeting —
  /// never tied to a campaign/engagement the way MEDIA_HOST/INFLUENCER payments usually are.
  MEMBER
}

enum PaymentStatus {
  /// Newly created, awaiting an admin's approval — shown as "Unpaid".
  PENDING
  /// Approved by an admin (authorized for Finance to pay) but not yet actually paid — shown as
  /// "Pending Payment". Only PaymentsService.markPaid() (Finance's own step) moves a payment out
  /// of this state, into PAID.
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

model Payment {
  id              String                 @id @default(uuid())
  organizationId  String                 @map("organization_id")
  campaignId      String?                @map("campaign_id")
  beneficiaryType PaymentBeneficiaryType @map("beneficiary_type")
  mediaHostId     String?                @map("media_host_id")
  influencerId    String?                @map("influencer_id")
  memberId        String?                @map("member_id")
  paymentDate     DateTime               @map("payment_date") @db.Date
  amount          Decimal                @db.Decimal(14, 2)
  currency        String                 @default("TZS")
  method          String?
  referenceNumber String?                @map("reference_number")
  description     String?                @db.Text
  // New payments always start PENDING and only become PAID once an admin (or a role an admin
  // has granted the "payment-approval" area to) explicitly approves them — see
  // PaymentsService.approve()/reject(). Never set directly from client input.
  status          PaymentStatus          @default(PENDING)
  documentUrl     String?                @map("document_url") @db.Text
  notes           String?                @db.Text

  // Conditional fields, populated depending on `method` (Bank transfer / Mobile money) —
  // bank/mobile identity is usually prefilled from the beneficiary's saved profile, while the
  // reference/transaction id is specific to this one payment.
  bankName              String? @map("bank_name")
  bankAccountName       String? @map("bank_account_name")
  bankAccountNumber     String? @map("bank_account_number")
  bankTransactionRef    String? @map("bank_transaction_ref")
  mobileMoneyProvider   String? @map("mobile_money_provider")
  mobileMoneyNumber     String? @map("mobile_money_number")
  mobileMoneyTransactionId String? @map("mobile_money_transaction_id")

  createdByUserId    String    @map("created_by_user_id")
  approvedByUserId   String?   @map("approved_by_user_id")
  approvedAt         DateTime? @map("approved_at")
  rejectedByUserId   String?   @map("rejected_by_user_id")
  rejectedAt         DateTime? @map("rejected_at")
  /// What Finance actually sent, recorded at markPaid() — can differ from `amount` (what the
  /// admin approved). When it differs, `amountVarianceNote` is required so there's always a
  /// reason on record for the gap. Null until Finance marks the payment paid.
  paidAmount         Decimal?  @db.Decimal(14, 2) @map("paid_amount")
  amountVarianceNote String?   @db.Text @map("amount_variance_note")
  mediaEngagementId  String? @unique @map("media_engagement_id")
  /// Set instead of mediaEngagementId when paying against an Influencer 2
  /// campaign (the influencer-side campaign system) rather than the original
  /// MediaEngagement — a payment only ever targets one or the other.
  influencer2CampaignId String? @unique @map("influencer2_campaign_id")

  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign            MediaCampaign?       @relation(fields: [campaignId], references: [id])
  mediaHost           MediaHost?           @relation(fields: [mediaHostId], references: [id])
  influencer          Influencer?          @relation(fields: [influencerId], references: [id])
  member              Member?              @relation(fields: [memberId], references: [id])
  mediaEngagement     MediaEngagement?     @relation(fields: [mediaEngagementId], references: [id])
  influencer2Campaign Influencer2Campaign? @relation(fields: [influencer2CampaignId], references: [id])
  postingAgreementEvaluation PostingAgreementEvaluation?

  @@index([organizationId])
  @@index([campaignId])
  @@index([mediaHostId])
  @@index([influencerId])
  @@index([memberId])
  @@map("payments")
}

enum ExpenseCategory {
  OPERATIONAL
  ADMINISTRATIVE
}

// Non-payment club spending — operating costs (fuel, printing, venue hire...) and administrative
// costs (office supplies, subscriptions...) tracked by Finance separately from the payments made
// to media hosts/influencers. totalCost is stored (not just computed) so a later unit-cost edit
// never silently rewrites a historical expense's recorded total.
model Expense {
  id              String          @id @default(uuid())
  organizationId  String          @map("organization_id")
  category        ExpenseCategory
  item            String
  purpose         String?         @db.Text
  quantity        Decimal         @db.Decimal(10, 2)
  unitCost        Decimal         @map("unit_cost") @db.Decimal(14, 2)
  totalCost       Decimal         @map("total_cost") @db.Decimal(14, 2)
  dateIssued      DateTime        @map("date_issued") @db.Date
  concernedParty  String?         @map("concerned_party")
  notes           String?         @db.Text
  createdByUserId String          @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, category])
  @@map("expenses")
}

/// Per-organization, per-role EXTRA grants for one nav area, layered on top of each area's
/// built-in default role list (see apps/web/src/lib/permissions.ts NAV_ACCESS and
/// apps/api/src/modules/permissions/permissions.service.ts). A row only ever ADDS access for a
/// role that isn't already allowed by default — the default roles for an area can't be revoked
/// through this table, so an admin can never accidentally lock themselves (or Finance) out.
model OrgRolePermission {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  role           RoleKey
  area           String
  // "view" | "create" | "edit" | "delete" — see permissions.constants.ts's ACTIONS.
  // Defaulted to "view" so pre-existing rows (written before this column existed)
  // keep meaning exactly what they always meant: area-level access.
  action         String   @default("view")
  allowed        Boolean  @default(true)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, area, action])
  @@index([organizationId])
  @@map("org_role_permissions")
}

/// One row per (organization, region) — the numeric target an admin configures for the
/// members-by-region and leaders-by-region dashboard charts to show hover progress against.
/// Either target may be left unset (no goal configured yet for that metric in that region).
model RegionTarget {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  region         String
  memberTarget   Int?     @map("member_target")
  leaderTarget   Int?     @map("leader_target")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, region])
  @@index([organizationId])
  @@map("region_targets")
}

/// A named, saved date range for the Media/Influencer dashboards' filter — "Week 1", "Week 2", etc.
/// — so a fixed reporting period can be revisited without retyping the same two dates every time.
/// Shared across the org (not per-user), since the point is a team-wide reference period.
model DashboardSavedView {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String
  fromDate        DateTime @map("from_date")
  toDate          DateTime @map("to_date")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("dashboard_saved_views")
}

// ─────────────────────────────────────────────────────────────────────────
// INFLUENCER 2 — isolated, experimental multi-platform content engagement
// module. One "campaign" is one piece of content, distributed across several
// social platforms, each with its own URL and its own public metrics. This
// exists to be compared against the original Influencer/MediaEngagement
// approach above and must stay fully independent of it: organizationId and
// influencerId below are deliberately PLAIN string columns with no Prisma
// @relation to Organization/Influencer, so neither of those models needs a
// back-relation field added — tenant/reference checks happen in the service
// layer instead of via a DB foreign key. Do not add a relation here without
// also reconsidering that isolation goal.
// ─────────────────────────────────────────────────────────────────────────

enum Influencer2ContentType {
  VIDEO
  IMAGE
  REEL
  STORY
  ARTICLE
  PODCAST
  AUDIO
  OTHER
}

enum Influencer2CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// Which campaign-level summary bucket a metric rolls into. SENTIMENT is the
/// estimated positive/negative/neutral comment breakdown — it never rolls
/// into the plain COMMENTS total (that stays the raw count) and never counts
/// toward Total Public Engagement (see Influencer2MetricDefinition.countsAsEngagement).
enum Influencer2MetricCategory {
  VIEWS
  LIKES
  COMMENTS
  SHARES
  SENTIMENT
  OTHER
}

enum Influencer2MetricSource {
  MANUAL_ENTRY
  ESTIMATED
  IMPORTED
  API
}

model Influencer2Platform {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")

  metricDefinitions Influencer2MetricDefinition[]
  campaignPlatforms Influencer2CampaignPlatform[]

  @@map("influencer2_platforms")
}

/// The "don't hard-code the form" layer — the create-campaign platform
/// checklist and the metrics-entry form both render fields FROM these rows,
/// not from per-platform React components, so adding a platform or a metric
/// later is a data change (seed/insert a row), not a rebuild.
model Influencer2MetricDefinition {
  id                 String                     @id @default(uuid())
  platformId         String                     @map("platform_id")
  key                String
  label              String
  category           Influencer2MetricCategory
  /// "percent" for the sentiment breakdown (must sum to 100 across the 3
  /// sentiment metrics of one platform — enforced client-side), null for a
  /// plain count. Lets the frontend render/validate without hardcoding keys.
  unit               String?
  /// Hidden on the form/table unless the campaign's contentType is
  /// VIDEO/REEL/STORY — e.g. Instagram "Views/Plays" only applies to video-like content.
  videoOnly          Boolean                    @default(false) @map("video_only")
  /// Whether this metric's value counts toward "Total Public Engagement".
  /// false for VIEWS (never an engagement) and SENTIMENT (a breakdown of an
  /// already-counted COMMENTS metric, not additional engagement).
  countsAsEngagement Boolean                    @default(true) @map("counts_as_engagement")
  sortOrder          Int                        @default(0) @map("sort_order")
  isActive           Boolean                    @default(true) @map("is_active")

  platform Influencer2Platform      @relation(fields: [platformId], references: [id], onDelete: Cascade)
  values   Influencer2MetricValue[]

  @@unique([platformId, key])
  @@map("influencer2_metric_definitions")
}

/// Payment status is separate from the workflow `status` above — this is the
/// financial state (has Finance paid for this campaign yet), mirroring
/// MediaEngagementStatus's role for the original Influencer/MediaHost system.
/// Only ever written by PaymentsService.create(), never by this module's own
/// create/update DTOs — same payment-integrity separation used elsewhere.
enum Influencer2PaymentStatus {
  NOT_PAID
  PAID
}

model Influencer2Campaign {
  id             String                     @id @default(uuid())
  organizationId String                     @map("organization_id")
  name           String
  code           String?
  contentType    Influencer2ContentType     @map("content_type")
  description    String?                    @db.Text
  contentDate    DateTime?                  @map("content_date")
  contentOwner   String?                    @map("content_owner")
  /// References the existing Influencer.id — deliberately unrelated at the DB
  /// level, see the module-level note above. A campaign belongs to EITHER an
  /// influencer OR a media host (mirrors MediaEngagement's mediaHostId/
  /// influencerId pair) — this model now serves both beneficiary types
  /// despite its name, kept as-is to avoid a disruptive rename.
  influencerId   String?                    @map("influencer_id")
  mediaHostId    String?                    @map("media_host_id")
  startDate      DateTime?                  @map("start_date")
  endDate        DateTime?                  @map("end_date")
  status         Influencer2CampaignStatus  @default(DRAFT)
  thumbnailUrl   String?                    @map("thumbnail_url") @db.Text
  notes          String?                    @db.Text
  createdBy      String?                    @map("created_by")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  /// Which week (1-based, per the beneficiary's own PostingAgreement.startDate cycle) this post
  /// counts toward for weekly-agreement evaluation — set explicitly at creation (defaulting to the
  /// current week, but changeable), never inferred from createdAt, since data entry can lag behind
  /// when content actually went up. Null when the beneficiary has no posting agreement, or the post
  /// predates this field — PostingAgreementsService then falls back to createdAt-range bucketing
  /// for those rows only, see Influencer2CampaignsService.weeklyAssessment.
  agreementWeekNumber Int? @map("agreement_week_number")

  /// Which folder ("campaign" in user-facing language, e.g. "Week 1") this post has been
  /// explicitly filed under — purely a grouping/assessment aid, never affects the post's own
  /// metrics or behavior. A folder's totals also automatically pick up any post published within
  /// its date range even without this set, see Influencer2CampaignsService.folderAssessment.
  /// References Influencer2Folder.id — deliberately unrelated at the DB level, same as
  /// influencerId/mediaHostId above.
  folderId String? @map("folder_id")

  // Filled in by PaymentsService.create() at pay time, mirroring how
  // MediaEngagement.rateTzs/totalTzs are never set at creation either.
  paymentStatus Influencer2PaymentStatus @default(NOT_PAID) @map("payment_status")
  rateTzs       Decimal?                 @map("rate_tzs") @db.Decimal(14, 2)
  totalTzs      Decimal?                 @map("total_tzs") @db.Decimal(14, 2)

  platforms Influencer2CampaignPlatform[]
  payment   Payment?

  @@index([organizationId])
  @@index([influencerId])
  @@index([mediaHostId])
  @@map("influencer2_campaigns")
}

/// One row per (campaign, platform) — the distribution record: where the
/// content was published and its own URL, independent of every other platform.
model Influencer2CampaignPlatform {
  id          String    @id @default(uuid())
  campaignId  String    @map("campaign_id")
  platformId  String    @map("platform_id")
  postUrl     String?   @map("post_url") @db.Text
  postId      String?   @map("post_id")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  campaign Influencer2Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform Influencer2Platform     @relation(fields: [platformId], references: [id])
  metrics  Influencer2MetricValue[]

  @@unique([campaignId, platformId])
  @@map("influencer2_campaign_platforms")
}

/// Append-only snapshots — never update a value in place; insert a new row
/// and flip isLatest so "current" reads stay a plain isLatest:true filter
/// while full history remains queryable for growth charts and milestones.
model Influencer2MetricValue {
  id                 String                  @id @default(uuid())
  campaignPlatformId String                  @map("campaign_platform_id")
  metricDefinitionId String                  @map("metric_definition_id")
  value              Decimal                 @db.Decimal(18, 2)
  source             Influencer2MetricSource @default(MANUAL_ENTRY)
  collectedAt        DateTime                @default(now()) @map("collected_at")
  collectedBy        String?                 @map("collected_by")
  isLatest           Boolean                 @default(true) @map("is_latest")
  createdAt          DateTime                @default(now()) @map("created_at")

  campaignPlatform Influencer2CampaignPlatform @relation(fields: [campaignPlatformId], references: [id], onDelete: Cascade)
  metricDefinition Influencer2MetricDefinition @relation(fields: [metricDefinitionId], references: [id])

  @@index([campaignPlatformId, metricDefinitionId, collectedAt])
  @@index([campaignPlatformId, isLatest])
  @@map("influencer2_metric_values")
}

/// A named, dated grouping of posts for one media host/influencer — user-facing name "campaign"
/// (e.g. "Week 1"), internal name kept as "folder" to avoid clashing with Influencer2Campaign
/// (which is actually one post, see its own doc comment). A post joins a folder either explicitly
/// (Influencer2Campaign.folderId) or automatically, by its published date falling inside
/// [startDate, endDate] — see Influencer2CampaignsService.folderAssessment. This is what a
/// PostingAgreement's target (post count / engagement) is checked against once folder-based
/// evaluation is used instead of the older auto-computed weekly cycle.
model Influencer2Folder {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  mediaHostId     String?   @map("media_host_id")
  influencerId    String?   @map("influencer_id")
  name            String
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([mediaHostId])
  @@index([influencerId])
  @@map("influencer2_folders")
}

/// One org-wide, named date window (e.g. "Week 1": Aug 18–28) set up ONCE and automatically applied
/// to EVERY media host and influencer at once — replaces each beneficiary getting their own
/// manually-dated Influencer2Folder for the same week. A post counts toward a week purely by its
/// published date falling in [startDate, endDate] (see Influencer2CampaignsService's
/// publishedDateFilter) — no separate tagging step, no per-beneficiary setup. This is what a
/// PostingAgreement's target is checked against for any beneficiary once evaluated via
/// PostingAgreementEvaluation.weekDefinitionId. Influencer2Folder itself is untouched and still
/// holds whatever campaigns were created before this existed, purely as historical record.
model PostingWeekDefinition {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String
  startDate       DateTime @db.Date @map("start_date")
  endDate         DateTime @db.Date @map("end_date")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("posting_week_definitions")
}

enum PostingAgreementEngagementMetric {
  VIEWS
  LIKES
  COMMENTS
  SHARES
  TOTAL_ENGAGEMENT
}

/// A media host/influencer's standing deal — general configuration only (a post-count target, an
/// engagement target, or both, plus the rate paid). `startDate` is a REFERENCE date only (when the
/// deal was agreed) and plays no part in counting anything — counting happens per campaign
/// (Influencer2Folder), each with its own date range, checked against this same configuration; the
/// older auto-computed weekly cycle (see computeWeeks) still exists for agreements that predate
/// folders, but new counting should go through folders. `weeklyAmount` is the rate paid PER POST
/// when postsPerWeek is set (ticket amount = weeklyAmount × actual post count once the post target
/// is met) — otherwise (engagement-only) it's a flat amount paid once the engagement target is
/// met, since there's no post count to multiply by. A target can be a post count, an engagement
/// metric, or both at once — "meets requirements" (PostingAgreementEvaluation.targetMet) only when
/// every target that's actually configured is met. Belongs to EITHER a media host OR an influencer,
/// mirroring Payment's own mediaHostId/influencerId pair. `attachmentUrl` is an optional copy of
/// the signed agreement/contract, purely for reference — it never affects any calculation.
model PostingAgreement {
  id               String                             @id @default(uuid())
  organizationId   String                             @map("organization_id")
  mediaHostId      String?                            @map("media_host_id")
  influencerId     String?                            @map("influencer_id")
  startDate        DateTime                           @map("start_date") @db.Date
  postsPerWeek     Int?                               @map("posts_per_week")
  engagementMetric PostingAgreementEngagementMetric?  @map("engagement_metric")
  engagementTarget Int?                               @map("engagement_target")
  weeklyAmount     Decimal                            @db.Decimal(14, 2) @map("weekly_amount")
  currency         String                             @default("TZS")
  isActive         Boolean                            @default(true) @map("is_active")
  notes            String?                            @db.Text
  attachmentUrl    String?                            @map("attachment_url") @db.Text
  createdByUserId  String?                            @map("created_by_user_id")
  createdAt        DateTime                           @default(now()) @map("created_at")
  updatedAt        DateTime                           @updatedAt @map("updated_at")

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaHost    MediaHost?                   @relation(fields: [mediaHostId], references: [id])
  influencer   Influencer?                  @relation(fields: [influencerId], references: [id])
  evaluations  PostingAgreementEvaluation[]

  @@index([organizationId])
  @@index([mediaHostId])
  @@index([influencerId])
  @@map("posting_agreements")
}

/// One (agreement-relative) week's actual posts/engagement measured against its agreement's
/// target(s), computed on demand from the same Influencer2Campaign aggregation the Media/
/// Influencer dashboards already read — never a background job. `weekNumber` is 1-based and
/// derived purely from the agreement's own startDate (see computeWeeks), so every agreement tracks
/// its own calendar regardless of when others started. postTargetMet/engagementTargetMet are each
/// null when that target isn't configured on the agreement at all; targetMet ("imefikia vigezo") is
/// true only when every configured target passed. `paymentId` is only set once an admin explicitly
/// turns a met-target week into a real Payment (reusing Payment's existing PENDING -> approve ->
/// paid workflow) — evaluation and ticket creation are always explicit, reviewable actions.
model PostingAgreementEvaluation {
  id                  String    @id @default(uuid())
  agreementId         String    @map("agreement_id")
  /// weekNumber/weekStart/weekEnd are set for the older auto-computed weekly cycle; folderId is
  /// set for a user-created folder ("campaign") instead; weekDefinitionId is set for the org-wide
  /// centralized week ("Week 1" applied to every beneficiary at once) — an evaluation is always
  /// exactly one of the three, never more than one, and every row here still means the same thing
  /// either way: one group's actual posts/engagement measured against its agreement's target(s).
  weekNumber          Int?      @map("week_number")
  weekStart           DateTime? @map("week_start") @db.Date
  weekEnd             DateTime? @map("week_end") @db.Date
  folderId            String?   @map("folder_id")
  weekDefinitionId    String?   @map("week_definition_id")
  actualPostCount     Int       @map("actual_post_count")
  actualViews         Int?      @map("actual_views")
  actualLikes         Int?      @map("actual_likes")
  actualComments      Int?      @map("actual_comments")
  actualShares        Int?      @map("actual_shares")
  actualEngagement    Int       @map("actual_engagement")
  postTargetMet       Boolean?  @map("post_target_met")
  engagementTargetMet Boolean?  @map("engagement_target_met")
  targetMet           Boolean   @map("target_met")
  paymentId           String?   @unique @map("payment_id")
  evaluatedByUserId   String?   @map("evaluated_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")

  agreement PostingAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  payment   Payment?         @relation(fields: [paymentId], references: [id])

  @@unique([agreementId, weekNumber])
  @@unique([agreementId, folderId])
  @@unique([agreementId, weekDefinitionId])
  @@index([agreementId])
  @@map("posting_agreement_evaluations")
}
