generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ORGANIZATIONS, USERS, RBAC
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  website      String?
  logoUrl      String?  @map("logo_url")
  heroImageUrl String?  @map("hero_image_url") @db.Text
  timezone     String   @default("UTC")
  settings     Json     @default("{}")
  mediaReachTarget Int? @map("media_reach_target")
  memberTarget     Int? @map("member_target")
  isDemo       Boolean  @default(false) @map("is_demo")
  status       OrgStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organizationMembers   OrganizationMember[]
  members               Member[]
  membershipSequences   MembershipNumberSequence[]
  events                Event[]
  posts                 Post[]
  aliases               OrganizationAlias[]
  socialAccounts        SocialAccount[]
  monitoringRules       MonitoringRule[]
  mentions              Mention[]
  newsArticles          NewsArticle[]
  webMentions           WebMention[]
  alerts                Alert[]
  metricSnapshots       MetricSnapshot[]
  reports               Report[]
  auditLogs             AuditLog[]
  attendanceDevices     AttendanceDevice[]
  syncJobs              SyncJob[]
  webhookEvents         WebhookEvent[]
  customFieldDefinitions CustomFieldDefinition[]
  mediaHosts             MediaHost[]
  influencers            Influencer[]
  mediaCampaigns         MediaCampaign[]
  payments               Payment[]
  mediaEngagements       MediaEngagement[]
  expenses               Expense[]
  rolePermissions        OrgRolePermission[]
  regionTargets          RegionTarget[]
  mediaOutlets           MediaOutlet[]
  dashboardSavedViews    DashboardSavedView[]
  postingAgreements      PostingAgreement[]

  @@map("organizations")
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String   @map("password_hash")
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  phone             String?
  profilePhotoUrl   String?  @map("profile_photo_url")
  isPlatformOwner   Boolean  @default(false) @map("is_platform_owner")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  status            UserStatus @default(PENDING_VERIFICATION)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organizationMembers OrganizationMember[]
  sessions            Session[]
  emailVerifications  EmailVerificationToken[]
  passwordResets      PasswordResetToken[]
  createdEvents       Event[] @relation("EventCreatedBy")
  createdPosts        Post[] @relation("PostCreatedBy")
  auditLogs           AuditLog[]
  reportsGenerated    Report[] @relation("ReportGeneratedBy")
  ownedMediaCampaigns MediaCampaign[]
  createdExpenses     Expense[]
  savedDashboardViews DashboardSavedView[]

  @@map("users")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Trimmed to exactly the roles the club actually uses — PLATFORM_OWNER stays
/// (a separate cross-org superuser flag, never an assignable org role, see
/// permissions.constants.ts) but EVENT_MANAGER/ATTENDANCE_OFFICER/
/// MEMBERSHIP_OFFICER/DIGITAL_INTELLIGENCE_ANALYST/REPORT_VIEWER were removed
/// per explicit request. Confirmed zero production OrganizationMember rows
/// and zero OrgRolePermission grants referenced any of them before removal.
enum RoleKey {
  PLATFORM_OWNER
  ORG_SUPER_ADMIN
  ORG_ADMIN
  FINANCE_OFFICER
  STANDARD_USER
  /// A time-boxed account for a specific purpose — same minimal default permissions as
  /// STANDARD_USER, but OrganizationMember.activeFrom/activeUntil additionally gate whether it can
  /// reach the organization at all right now (see OrgMembershipGuard). Outside that window, access
  /// is blocked the same way a SUSPENDED member's is — login itself still works, but every
  /// org-scoped request is refused.
  GUEST_USER
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           RoleKey
  status         OrgMemberStatus @default(ACTIVE)
  invitedAt      DateTime? @map("invited_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  /// Only meaningful for role GUEST_USER — the date/time range this member can actually reach the
  /// organization in (see OrgMembershipGuard). Null on either end means unbounded on that side.
  /// Ignored for every other role.
  activeFrom     DateTime? @map("active_from")
  activeUntil    DateTime? @map("active_until")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

enum OrgMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

// ─────────────────────────────────────────────────────────────────────────
// MEMBERSHIP
// ─────────────────────────────────────────────────────────────────────────

model MembershipNumberSequence {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  prefix         String
  nextValue      Int      @default(1) @map("next_value")
  padding        Int      @default(6)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, prefix])
  @@map("membership_number_sequences")
}

enum MembershipType {
  REGULAR
  PREMIUM
  HONORARY
  STUDENT
  CORPORATE
  LIFETIME
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

// The single "campaign member" record — every person known to the system,
// whether or not they hold a real club membership number. campaignId is
// always assigned by this system on creation; membershipNumber is an
// external identifier from the club's own register and is only ever set
// when the person actually provided/holds one — never invented here.
model Member {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  campaignId         String   @unique @map("campaign_id")
  membershipNumber   String?  @map("membership_number")
  firstName          String   @map("first_name")
  middleName         String?  @map("middle_name")
  lastName           String   @map("last_name")
  gender             Gender   @default(UNSPECIFIED)
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  phone              String?
  email              String?
  address            String?
  region             String?
  district           String?
  ward               String?
  branch             String?
  isLeader           Boolean  @default(false) @map("is_leader")
  membershipType     MembershipType @default(REGULAR) @map("membership_type")
  membershipStatus   MembershipStatus @default(ACTIVE) @map("membership_status")
  profilePhotoUrl    String?  @map("profile_photo_url")
  customFields       Json     @default("{}") @map("custom_fields")
  registrationDate   DateTime @default(now()) @map("registration_date")
  registrationSource MemberSource @default(ADMIN) @map("registration_source")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membershipHistory  MembershipHistory[]
  eventRegistrations EventRegistration[]
  attendanceRecords  AttendanceRecord[]
  postRegistrations  PostRegistration[]
  payments           Payment[]

  @@unique([organizationId, membershipNumber])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, region, district])
  @@index([organizationId, membershipStatus])
  @@index([organizationId, isLeader])
  @@map("members")
}

enum MemberSource {
  ADMIN
  SELF_REGISTRATION
  EVENT_WALK_IN
  IMPORT
}

model MembershipHistory {
  id         String   @id @default(uuid())
  memberId   String   @map("member_id")
  fromStatus MembershipStatus? @map("from_status")
  toStatus   MembershipStatus  @map("to_status")
  fromType   MembershipType?   @map("from_type")
  toType     MembershipType?   @map("to_type")
  reason     String?
  changedByUserId String? @map("changed_by_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("membership_history")
}

model CustomFieldDefinition {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  label          String
  fieldType      CustomFieldType @map("field_type")
  options        Json?
  isRequired     Boolean  @default(false) @map("is_required")
  appliesTo      CustomFieldTarget @default(MEMBER) @map("applies_to")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, appliesTo, key])
  @@map("custom_field_definitions")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

enum CustomFieldTarget {
  MEMBER
  EVENT
}

// ─────────────────────────────────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  UPCOMING
  OPEN
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

model Event {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  name                  String
  description           String?  @db.Text
  eventType             String?  @map("event_type")
  location              String?
  startDatetime         DateTime @map("start_datetime")
  endDatetime           DateTime @map("end_datetime")
  capacity              Int?
  status                EventStatus @default(DRAFT)
  registrationEnabled   Boolean  @default(true) @map("registration_enabled")
  attendanceEnabled     Boolean  @default(true) @map("attendance_enabled")
  // Defaulted to false per explicit request — the client wants the plain QR-scan +
  // membership-number flow (no prior registration needed, no per-attendee ticket QR
  // generated) as the out-of-the-box behavior for new events. AttendanceService.checkIn()
  // already auto-creates the EventRegistration on the fly for any existing member, so this
  // default doesn't add a registration requirement — it only hides the separate walk-in/
  // new-member path (which does generate its own ticket QR) unless explicitly turned on.
  allowWalkIns          Boolean  @default(false) @map("allow_walk_ins")
  allowNewMemberReg     Boolean  @default(false) @map("allow_new_member_registration")
  requireApproval       Boolean  @default(false) @map("require_approval")
  requirePhoneVerification Boolean @default(false) @map("require_phone_verification")
  autoCheckInNewMembers Boolean  @default(true) @map("auto_check_in_new_members")
  // When on, a walk-in registration matching an existing registrant's phone number
  // (within this event) is treated as already-registered instead of creating a
  // second Member/EventRegistration — a configurable "one response per person" cap
  // for the public walk-in form. Off by default (existing behavior unchanged).
  limitOneResponsePerPerson Boolean @default(false) @map("limit_one_response_per_person")
  recommendation        String?  @db.Text
  meetingNote           String?  @db.Text @map("meeting_note")
  budget                Decimal? @db.Decimal(14, 2)
  monitoringKeywords    Json     @default("[]") @map("monitoring_keywords")
  customFields          Json     @default("{}") @map("custom_fields")
  createdByUserId       String   @map("created_by_user_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User @relation("EventCreatedBy", fields: [createdByUserId], references: [id])
  registrations      EventRegistration[]
  attendanceRecords  AttendanceRecord[]
  attendanceSessions AttendanceSession[]
  attendanceTokens   AttendanceToken[]
  attendanceDevices  AttendanceDevice[]
  metricSnapshots    MetricSnapshot[]

  @@index([organizationId, status])
  @@index([organizationId, startDatetime])
  @@map("events")
}

// EVENT posts collect RSVPs (register button, tracked participants); UPDATE
// posts are general news/campaign posts that only take a like + share, never
// a registration.
enum PostType {
  EVENT
  UPDATE
}

model Post {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  postType       PostType  @default(EVENT) @map("post_type")
  title          String
  description    String    @db.Text
  audience       String?
  location       String?
  imageUrl       String?   @map("image_url") @db.Text
  eventDate      DateTime? @map("event_date")
  likeCount      Int       @default(0) @map("like_count")
  published      Boolean   @default(true)
  createdByUserId String   @map("created_by_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User @relation("PostCreatedBy", fields: [createdByUserId], references: [id])
  registrations PostRegistration[]

  @@index([organizationId, createdAt])
  @@map("posts")
}

// A Member's expressed interest in one specific post ("Sajili Kushiriki").
// No personal data lives here — that's all on Member now. The general
// /register page doesn't create rows here at all; it just creates/finds a
// Member directly, since "become a campaign member" isn't tied to any post.
model PostRegistration {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  memberId  String   @map("member_id")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
  @@index([memberId])
  @@map("post_registrations")
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  APPROVED
  REJECTED
}

enum RegistrationSource {
  ADMIN
  SELF_SERVICE
  WALK_IN
  IMPORT
  API
}

model EventRegistration {
  id                 String   @id @default(uuid())
  eventId            String   @map("event_id")
  memberId           String   @map("member_id")
  registrationStatus RegistrationStatus @default(REGISTERED) @map("registration_status")
  source             RegistrationSource @default(ADMIN)
  registeredAt       DateTime @default(now()) @map("registered_at")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([eventId, registrationStatus])
  @@map("event_registrations")
}

// ─────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────

enum AttendanceMethod {
  QR
  MEMBERSHIP_NUMBER
  WALK_IN
  ADMIN
  IMPORT
  OFFLINE_SYNC
}

enum AttendanceSyncStatus {
  CONFIRMED
  PENDING_SYNC
  SYNC_ERROR
}

model AttendanceRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  eventId        String   @map("event_id")
  memberId       String   @map("member_id")
  method         AttendanceMethod
  syncStatus     AttendanceSyncStatus @default(CONFIRMED) @map("sync_status")
  deviceId       String?  @map("device_id")
  checkedInByUserId String? @map("checked_in_by_user_id")
  clientRecordId String?  @map("client_record_id")
  checkedInAt    DateTime @default(now()) @map("checked_in_at")
  createdAt      DateTime @default(now()) @map("created_at")

  event  Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  device AttendanceDevice? @relation(fields: [deviceId], references: [id])

  @@unique([eventId, memberId])
  @@unique([deviceId, clientRecordId])
  @@index([organizationId, eventId])
  @@index([eventId, checkedInAt])
  @@map("attendance_records")
}

model AttendanceSession {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  name       String
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime? @map("ends_at")
  createdAt  DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("attendance_sessions")
}

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  KIOSK
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
}

model AttendanceDevice {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  eventId        String?  @map("event_id")
  name           String
  deviceType     DeviceType @map("device_type")
  status         DeviceStatus @default(ACTIVE)
  lastSeenAt     DateTime? @map("last_seen_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event             Event? @relation(fields: [eventId], references: [id])
  attendanceRecords AttendanceRecord[]

  @@index([organizationId])
  @@map("attendance_devices")
}

enum TokenStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model AttendanceToken {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  tokenHash  String   @unique @map("token_hash")
  status     TokenStatus @default(ACTIVE)
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@map("attendance_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// DIGITAL INTELLIGENCE
// ─────────────────────────────────────────────────────────────────────────

model OrganizationAlias {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  alias          String
  aliasType      AliasType @map("alias_type")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, alias])
  @@map("organization_aliases")
}

enum AliasType {
  NAME
  ACRONYM
  HANDLE
  HASHTAG
  DOMAIN
  KEYWORD
}

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
  META
  LINKEDIN
  X
  FACEBOOK
  THREADS
  TIKTOK
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  TOKEN_EXPIRED
}

model SocialAccount {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  platform          SocialPlatform
  handle            String?
  externalAccountId String?  @map("external_account_id")
  status            ConnectionStatus @default(DISCONNECTED)
  accessTokenEnc    String?  @map("access_token_enc") @db.Text
  refreshTokenEnc   String?  @map("refresh_token_enc") @db.Text
  tokenExpiresAt    DateTime? @map("token_expires_at")
  lastSyncedAt      DateTime? @map("last_synced_at")
  lastError         String?  @map("last_error")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metricSnapshots MetricSnapshot[]
  content         Content[]

  @@unique([organizationId, platform, externalAccountId])
  @@map("social_accounts")
}

enum CapabilityStatus {
  SUPPORTED
  PARTIAL
  UNSUPPORTED
  REQUIRES_APPROVAL
}

model PlatformCapability {
  id                  String   @id @default(uuid())
  platform            SocialPlatform
  capability          String
  status              CapabilityStatus
  apiVersion          String?  @map("api_version")
  documentationUrl    String?  @map("documentation_url")
  accessRequirements  String?  @map("access_requirements")
  lastVerifiedAt      DateTime? @map("last_verified_at")
  notes               String?

  @@unique([platform, capability])
  @@map("platform_capabilities")
}

enum MonitoringQueryType {
  EXACT_PHRASE
  KEYWORD
  BOOLEAN
  DOMAIN
  HASHTAG
}

model MonitoringRule {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  eventId        String?  @map("event_id")
  isActive       Boolean  @default(true) @map("is_active")
  languages      Json     @default("[]")
  countries      Json     @default("[]")
  platforms      Json     @default("[]")
  dateRangeStart DateTime? @map("date_range_start")
  dateRangeEnd   DateTime? @map("date_range_end")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queries      MonitoringQuery[]

  @@index([organizationId, isActive])
  @@map("monitoring_rules")
}

model MonitoringQuery {
  id        String   @id @default(uuid())
  ruleId    String   @map("rule_id")
  queryType MonitoringQueryType @map("query_type")
  value     String
  generated Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  rule MonitoringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("monitoring_queries")
}

enum ContentType {
  POST
  VIDEO
  STORY
  REEL
  ARTICLE
}

model Content {
  id              String   @id @default(uuid())
  socialAccountId String   @map("social_account_id")
  externalId      String   @map("external_id")
  contentType     ContentType @map("content_type")
  caption         String?  @db.Text
  url             String?  @db.Text
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime @default(now()) @map("created_at")

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  metrics       ContentMetric[]

  @@unique([socialAccountId, externalId])
  @@map("content")
}

model ContentMetric {
  id          String   @id @default(uuid())
  contentId   String   @map("content_id")
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  views       Int?
  reach       Int?
  impressions Int?
  capturedAt  DateTime @default(now()) @map("captured_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, capturedAt])
  @@map("content_metrics")
}

enum VerificationStatus {
  PLATFORM_VERIFIED
  SOURCE_VERIFIED
  DISCOVERED
  AI_DERIVED
  UNVERIFIED
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MIXED
  UNKNOWN
}

enum MentionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Mention {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  eventId          String?  @map("event_id")
  canonicalId      String   @map("canonical_id")
  dedupeKey        String   @map("dedupe_key")
  sourceType       String   @map("source_type")
  sourceProvider   String   @map("source_provider")
  sourceId         String?  @map("source_id")
  sourceUrl        String?  @map("source_url") @db.Text
  sourceTimestamp  DateTime? @map("source_timestamp")
  detectedAt       DateTime @default(now()) @map("detected_at")
  verificationStatus VerificationStatus @default(DISCOVERED) @map("verification_status")
  author           String?
